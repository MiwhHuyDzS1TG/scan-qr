APP_ENV=production
BASE_URL=https://chuyencan.chuyenthanglongdalat.edu.vn

# Production admin authentication
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD_HASH=scrypt$...
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=28800

# Private QR mapping. Prefer this variable on Vercel.
QR_DATA_JSON=
MEMBER_METADATA_JSON={}

# Upstream school session cookies. Server-side only.
CF_CLEARANCE=
LARAVEL_SESSION=
REMEMBER_WEB=
XSRF_TOKEN=
